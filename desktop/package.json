{
  "name": "filebridge-desktop",
  "version": "1.0.0",
  "description": "FileBridge Desktop Companion & Sync Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "filebridge",
    "cloud",
    "storage",
    "electron",
    "sync"
  ],
  "author": "Mohammed Saad Shaikh",
  "license": "MIT",
  "build": {
    "appId": "com.filebridge.app",
    "productName": "FileBridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "sync/**/*",
      "../client/dist/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FileBridge",
      "uninstallDisplayName": "FileBridge"
    }
  },
  "dependencies": {
    "axios": "^1.7.9",
    "chokidar": "^4.0.3",
    "dotenv": "^16.4.7",
    "form-data": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
